# Copy to .env and fill in from the event page. Placeholders only - never commit real values.
VITE_CONTRACT_ADDRESS=0xYourReferenceContractAddress
# Block the reference contract was deployed at (keeps log queries small on public RPCs)
VITE_DEPLOY_BLOCK=0
# Optional: your own Base Sepolia RPC URL (public default is used if empty)
VITE_RPC_URL=
